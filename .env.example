# Copy to .env and fill in real values. Never commit .env.
CLIENT_PORT=8092
DB_ROOT_PASSWORD=change-me-root
DB_USER=procurement
DB_PASSWORD=change-me
DB_NAME=procurement
# Long, random, unique per deployment (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Must match how you open the app in the browser (used for CORS + cookies)
FRONTEND_ORIGIN=http://localhost:8092
# Set to "true" once the app sits behind HTTPS
COOKIE_SECURE=false
# Outgoing e-mail (TEC appointments and reminders). Leave SMTP_HOST empty to record e-mails without sending.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "LECO Procurement <procurement@leco.lk>"
MAIL_FROM=
